node_modules/
bin/
__pycache__/

# Timing log, rewritten on every run. A second concurrent session writes
# tweb-<pid>.log rather than trampling the first one's.
tweb.log
tweb-*.log

# Network captures used for debugging. These contain live session cookies
# (cf_clearance, login sessions) and must never be committed.
out/
*.saz

# Logs produced by the stable/beta/nightly Firefox container matrix.
firefox-diagnostics/

# Per-run logs, results, and summary written by tools/test_release_matrix.sh.
release-matrix/

# Logs and machine-readable results written by long-tests.sh.
long-tests/

# The edbrowse side of the integration — the plugin, its .ebrc fragment, the
# patches to edbrowse and the study — is its own repository living here. It
# carries its own .git and its own edbrowse checkout; it is not ours to
# track.
edbrowse-plugin/

# Upstream Lynx source kept beside TAWB while the compatibility interface is
# implemented and checked. It is a reference checkout, not vendored code.
lynx/

# Static dependency cache built by tools/build_deps.sh.
build/
