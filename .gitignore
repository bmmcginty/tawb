node_modules/

# Timing log, rewritten on every run. A second concurrent session writes
# tweb-<pid>.log rather than trampling the first one's.
tweb.log
tweb-*.log

# Network captures used for debugging. These contain live session cookies
# (cf_clearance, login sessions) and must never be committed.
out/
*.saz

# The edbrowse side of the integration — the plugin, its .ebrc fragment, the
# patches to edbrowse and the study — is its own repository living here. It
# carries its own .git and its own edbrowse checkout; it is not ours to
# track.
edbrowse-plugin/
