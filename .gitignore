node_modules/

# Timing log, rewritten on every run. A second concurrent session writes
# tweb-<pid>.log rather than trampling the first one's.
tweb.log
tweb-*.log

# Network captures used for debugging. These contain live session cookies
# (cf_clearance, login sessions) and must never be committed.
out/
*.saz

# A checkout of edbrowse, kept here to read its source while designing the
# integration. It is upstream's repository with its own .git, not ours to
# vendor — remove this line if it should be a submodule instead.
tui-browser/edbrowse/
