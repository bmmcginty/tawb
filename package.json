{
  "name": "tawb",
  "version": "1.0.1",
  "description": "",
  "main": "src/index.js",
  "bin": {
    "tawb": "src/index.js"
  },
  "scripts": {
    "start": "node src/index.js",
    "test": "node --test test/*.test.js",
    "compare": "node tools/compare.js",
    "firefox": "node src/index.js --browser firefox",
    "edb": "node src/edb.js",
    "testpage": "node tools/serve.js",
    "coverage": "node tools/serve.js --page coverage",
    "authpage": "node tools/authserve.js",
    "dump": "node tools/dump.js",
    "probe": "node tools/probe.js",
    "diagnose:firefox": "node tools/diagnose_firefox.js",
    "test:firefox-releases": "tools/test_firefox_releases.sh",
    "browsers": "node tools/browsers.js",
    "test:browser": "node --test --test-concurrency=2 test/browser/*.test.js",
    "test:aria-at": "node --test --test-concurrency=1 test/browser/aria_at.test.js",
    "test:wai-aria": "node tools/wpt.js --suite wai-aria --fail-on-mismatch",
    "axe": "node tools/axe.js",
    "wpt": "node tools/wpt.js"
  },
  "keywords": [],
  "type": "commonjs",
  "devDependencies": {
    "axe-core": "^4.13.0"
  }
}
